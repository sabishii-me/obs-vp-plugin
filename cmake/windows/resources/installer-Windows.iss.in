#define MyAppName "@CMAKE_PROJECT_NAME@"
#define MyAppVersion "@CMAKE_PROJECT_VERSION@"
#define MyAppPublisher "@PLUGIN_AUTHOR@"
#define MyAppURL "@PLUGIN_WEBSITE@"

[Setup]
AppId={{@UUID_APP@}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={code:GetOBSDirName}
AppendDefaultDirName=no
DefaultGroupName={#MyAppName}
OutputBaseFilename={#MyAppName}-{#MyAppVersion}-windows-installer
Compression=lzma
SolidCompression=yes
DirExistsWarning=no
AllowNoIcons=yes
WizardStyle=modern
CloseApplications=yes
UninstallDisplayName={#MyAppName}
UninstallFilesDir={app}\uninstall\{#MyAppName}

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "..\release\Package\{#MyAppName}\bin\64bit\*"; DestDir: "{app}\obs-plugins\64bit"; Flags: ignoreversion
Source: "..\release\Package\{#MyAppName}\data\*"; DestDir: "{app}\data\obs-plugins\{#MyAppName}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"

[Code]
function GetOBSDirName(Value: string): string;
var
  InstallPath: string;
begin
  Result := ExpandConstant('{pf}\obs-studio');
  if RegQueryStringValue(HKLM32, 'SOFTWARE\OBS Studio', '', InstallPath) then
    Result := InstallPath;
  if RegQueryStringValue(HKLM64, 'SOFTWARE\OBS Studio', '', InstallPath) then
    Result := InstallPath;
end;

function NextButtonClick(PageId: Integer): Boolean;
var
  ObsFileName: string;
begin
  Result := True;
  if not (PageId = wpSelectDir) then exit;
  ObsFileName := ExpandConstant('{app}\bin\64bit\obs64.exe');
  if not FileExists(ObsFileName) then begin
    MsgBox('OBS Studio does not appear to be installed in that folder. Please select the correct OBS Studio folder.', mbError, MB_OK);
    Result := False;
  end;
end;
